# Copy to .env.local (gitignored) and fill in. NEXT_PUBLIC_* values are inlined
# into the client bundle at build time — never put secrets in them.

# Curator.io Instagram feed (components/instagram-mosaic.tsx).
# 1. Create a feed at https://curator.io using the Mosaic template
#    (https://curator.io/templates/mosaic) and connect the clinic's Instagram.
# 2. Publish the feed and copy the id from the embed script URL:
#    https://cdn.curator.io/published/<FEED_ID>.js
# 3. Set `enabled: true` on `curatorFeed` in data/site-config.ts and rebuild.
# While the feed is off, the section shows the clinic's downloaded posts instead.
NEXT_PUBLIC_CURATOR_FEED_ID=

# Only set this if Curator's embed code shows a container id other than the
# default "curator-feed-default-feed-layout".
NEXT_PUBLIC_CURATOR_CONTAINER_ID=

# Cloudflare Web Analytics (components/analytics.tsx). Cookieless, so it needs no
# consent banner, and it works on any host. Cloudflare dashboard -> Web Analytics
# -> Add a site -> enter the domain -> manual JavaScript snippet -> copy the value
# of "token". Leave empty to render no analytics script at all.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
